# OpenFlow run logs: every prompt and every agent answer of a local run, which
# is both noise and a place secrets end up. Pipelines and the agent blocks they
# generate are deliberately tracked.
.openflow/runs/

# Scratch project a run was pointed at with OPENFLOW_PROJECT. Its own .openflow
# lands inside it, so it is run state at one more level of nesting.
FlappyBird/

# The local role library: roles the user added on this machine, saved by the
# canvas. Personal state, unlike the pipelines and generated agent blocks above.
.openflow/roles.json

# Only the shipped templates are tracked under pipelines/ and generated/. Every
# other file there is a canvas saved or run against this repo during a smoke
# test - local state, not a deliverable.
.openflow/pipelines/*
.openflow/generated/*
!.openflow/pipelines/diamond.json
!.openflow/pipelines/feature-build.json
!.openflow/generated/diamond.opencode.json
!.openflow/generated/feature-build.opencode.json
!.openflow/generated/orchestrated-build.opencode.json

